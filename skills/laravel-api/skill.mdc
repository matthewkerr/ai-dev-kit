## Policy Pattern

```php
<?php

declare(strict_types=1);

namespace App\Policies;

use App\Models\Post;
use App\Models\User;

class PostPolicy
{
    public function viewAny(User $user): bool     { return true; }
    public function view(?User $user, Post $post): bool { return $post->published || $user?->id === $post->user_id; }
    public function create(User $user): bool      { return true; }
    public function update(User $user, Post $post): bool { return $user->id === $post->user_id; }
    public function delete(User $user, Post $post): bool { return $user->id === $post->user_id; }
}
```

