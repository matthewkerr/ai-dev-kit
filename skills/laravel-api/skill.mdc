## Jobs & Queues

```php
<?php

declare(strict_types=1);

namespace App\Jobs;

use App\Models\Post;
use Illuminate\Bus\Queueable;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Foundation\Bus\Dispatchable;
use Illuminate\Queue\InteractsWithQueue;
use Illuminate\Queue\SerializesModels;

class ProcessPostPublished implements ShouldQueue
{
    use Dispatchable, InteractsWithQueue, Queueable, SerializesModels;

    public int $tries = 3;
    public int $backoff = 30; // seconds between retries

    public function __construct(public readonly Post $post) {}

    public function handle(): void
    {
        // Heavy work: send notifications, index for search, update stats, etc.
        // This runs in the background — never block a request with this work.
        NotifyFollowers::dispatch($this->post);
    }

    public function failed(\Throwable $e): void
    {
        // Log or alert — called after all retries exhausted
        \Log::error('ProcessPostPublished failed', ['post' => $this->post->id, 'error' => $e->getMessage()]);
    }
}

// Dispatch from service layer:
// ProcessPostPublished::dispatch($post);
// ProcessPostPublished::dispatchAfterResponse($post); // after HTTP response sent
```

```bash
# Always run a queue worker in production
php artisan queue:work redis --queue=default --tries=3 --sleep=3

# For Horizon (recommended for Redis queues)
composer require laravel/horizon
php artisan horizon
```

