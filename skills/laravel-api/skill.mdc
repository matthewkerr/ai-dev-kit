## Testing Pattern

```php
<?php

declare(strict_types=1);

namespace Tests\Feature\Api;

use App\Models\Post;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class PostApiTest extends TestCase
{
    use RefreshDatabase;

    public function test_authenticated_user_can_create_post(): void
    {
        $user = User::factory()->create();

        $response = $this->actingAs($user)
            ->postJson('/api/v1/posts', [
                'title'   => 'Test Post',
                'slug'    => 'test-post',
                'content' => 'This is test content that is long enough.',
            ]);

        $response->assertCreated()
            ->assertJsonStructure([
                'data' => ['id', 'title', 'slug', 'created_at'],
            ]);

        $this->assertDatabaseHas('posts', ['slug' => 'test-post', 'user_id' => $user->id]);
    }

    public function test_unauthenticated_user_cannot_create_post(): void
    {
        $this->postJson('/api/v1/posts', ['title' => 'Test'])
            ->assertUnauthorized();
    }

    public function test_user_cannot_update_another_users_post(): void
    {
        $post = Post::factory()->create();
        $otherUser = User::factory()->create();

        $this->actingAs($otherUser)
            ->putJson("/api/v1/posts/{$post->id}", ['title' => 'Hijacked'])
            ->assertForbidden();
    }
}
```

