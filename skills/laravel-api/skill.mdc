## Service Layer

```php
<?php

declare(strict_types=1);

namespace App\Services;

use App\Models\Post;
use App\Models\User;
use App\Events\PostPublished;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\DB;

class PostService
{
    public function getPaginatedForUser(User $user): LengthAwarePaginator
    {
        return Post::query()
            ->where('user_id', $user->id)
            ->with('tags')
            ->orderByDesc('created_at')
            ->paginate(15);
    }

    public function create(array $validated, User $user): Post
    {
        return DB::transaction(function () use ($validated, $user) {
            $post = $user->posts()->create(
                collect($validated)->except('tags')->toArray()
            );

            if (! empty($validated['tags'])) {
                $post->tags()->sync($validated['tags']);
            }

            if ($post->published) {
                PostPublished::dispatch($post);
            }

            return $post->fresh('tags');
        });
    }

    public function update(Post $post, array $validated): Post
    {
        return DB::transaction(function () use ($post, $validated) {
            $post->update(collect($validated)->except('tags')->toArray());

            if (array_key_exists('tags', $validated)) {
                $post->tags()->sync($validated['tags']);
            }

            return $post->fresh('tags');
        });
    }
}
```

