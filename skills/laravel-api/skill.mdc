## Caching

```php
// Cache expensive queries — never cache inside a model, always in the service
use Illuminate\Support\Facades\Cache;

// Pattern 1: remember (auto-expire)
$stats = Cache::remember("user.{$userId}.stats", now()->addHour(), function () use ($userId) {
    return $this->computeExpensiveStats($userId);
});

// Pattern 2: tags (invalidate related cache together) — requires Redis
Cache::tags(['posts', "user.{$userId}"])->remember("posts.{$userId}", 600, fn() => ...);
Cache::tags(['posts'])->flush(); // invalidate all post caches on write

// Pattern 3: forever + manual invalidation
Cache::forever("config.features", $features);
Cache::forget("config.features"); // on update

// Always clear relevant cache on model write
public function update(Post $post, array $validated): Post
{
    $post->update($validated);
    Cache::forget("post.{$post->slug}");
    Cache::tags(['posts'])->flush();
    return $post->fresh();
}
```

