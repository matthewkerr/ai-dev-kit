## Type System Discipline

### Prefer Explicit Types
```typescript
// BAD — inferred any, loose
function process(data: any) { return data.result; }

// GOOD — explicit, safe
function process(data: { result: string }): string {
  return data.result;
}

// Use unknown instead of any for truly unknown values
function parseInput(raw: unknown): string {
  if (typeof raw !== 'string') throw new TypeError('Expected string');
  return raw;
}
```

### Discriminated Unions (prefer over nullable types)
```typescript
// BAD
interface ApiResponse {
  data?: Post;
  error?: string;
}

// GOOD — exhaustive, compiler-enforced
type ApiResult<T> =
  | { status: 'success'; data: T }
  | { status: 'error'; error: string; code: number }
  | { status: 'loading' };

function render(result: ApiResult<Post>) {
  switch (result.status) {
    case 'success': return result.data.title;       // data is typed
    case 'error':   return result.error;             // error is typed
    case 'loading': return 'Loading...';
    // Compiler warns if you add a new case and forget it here
  }
}
```

### Utility Types — Know These
```typescript
type PartialPost  = Partial<Post>;               // all optional
type RequiredPost = Required<Post>;              // all required
type PostTitle    = Pick<Post, 'title' | 'slug'>; // subset
type PostNoId     = Omit<Post, 'id'>;            // exclude
type ReadPost     = Readonly<Post>;              // immutable
type PostRecord   = Record<string, Post>;        // dict
type PostKeys     = keyof Post;                  // union of keys
type PostId       = Post['id'];                  // indexed access
```

### Branded Types — Prevent ID Mix-ups
```typescript
// Branded (nominal) types make type-incompatible what TypeScript treats as equivalent
type Brand<T, B extends string> = T & { readonly __brand: B };

type UserId  = Brand<string, 'UserId'>;
type PostId  = Brand<string, 'PostId'>;
type OrderId = Brand<string, 'OrderId'>;

// Constructor functions — the only way to create a branded value
function userId(id: string):  UserId  { return id as UserId; }
function postId(id: string):  PostId  { return id as PostId; }
function orderId(id: string): OrderId { return id as OrderId; }

// Now these are type errors — catches entire class of bugs
function getPost(id: PostId) { /* ... */ }
const uid = userId('abc-123');
getPost(uid); // TypeScript error: UserId is not assignable to PostId ✓
```

### Satisfies Operator (TypeScript 4.9+)
```typescript
// Validates shape without widening the type
const config = {
  db: { host: 'localhost', port: 5432 },
  api: { url: 'https://api.example.com' },
} satisfies Record<string, Record<string, string | number>>;

// config.db.port is still typed as number, not string | number
```

