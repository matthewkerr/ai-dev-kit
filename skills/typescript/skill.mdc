## Functional Utilities

### Type-Safe Object Utilities
```typescript
// Type-safe Object.keys/entries/fromEntries
function objectKeys<T extends object>(obj: T): (keyof T)[] {
  return Object.keys(obj) as (keyof T)[];
}

function objectEntries<T extends object>(obj: T): [keyof T, T[keyof T]][] {
  return Object.entries(obj) as [keyof T, T[keyof T]][];
}

// Deep partial
type DeepPartial<T> = T extends object
  ? { [P in keyof T]?: DeepPartial<T[P]> }
  : T;

// Non-nullable
type NonNullableFields<T> = { [K in keyof T]-?: NonNullable<T[K]> };
```

### Immutable Update Helpers
```typescript
// Use structuredClone for deep copies (Node 17+, modern browsers)
const clone = structuredClone(original);

// Prefer spreading for immutable updates
const updated = { ...post, title: newTitle, updatedAt: new Date() };
const withItem = [...items, newItem];
const withoutItem = items.filter(item => item.id !== idToRemove);
```

