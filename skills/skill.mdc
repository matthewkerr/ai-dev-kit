## Multi-Agent Orchestration

### Orchestrator / Subagent Pattern
```typescript
// Orchestrators decompose tasks and delegate to specialist subagents.
// Subagents never know about each other — only the orchestrator coordinates.

interface SubagentTask {
  agentId: string;
  input: unknown;
  timeoutMs?: number;
}

interface SubagentResult {
  agentId: string;
  output: unknown;
  durationMs: number;
  success: boolean;
  error?: string;
}

class OrchestratorAgent extends AgentLoop {
  private subagents = new Map<string, AgentLoop>();

  register(id: string, agent: AgentLoop) {
    this.subagents.set(id, agent);
  }

  // Run subagents in parallel; collect results
  async dispatch(tasks: SubagentTask[]): Promise<SubagentResult[]> {
    return Promise.all(tasks.map(async (task) => {
      const agent = this.subagents.get(task.agentId);
      if (!agent) return { agentId: task.agentId, output: null, durationMs: 0, success: false, error: 'Agent not found' };

      const start = Date.now();
      try {
        const output = await Promise.race([
          agent.runOnce(task.input),
          new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), task.timeoutMs ?? 30_000)),
        ]);
        return { agentId: task.agentId, output, durationMs: Date.now() - start, success: true };
      } catch (err) {
        return { agentId: task.agentId, output: null, durationMs: Date.now() - start, success: false, error: String(err) };
      }
    }));
  }
}
```

### Agent Handoff Protocol
```typescript
// Agents communicate via typed handoff messages — never shared mutable state
interface HandoffMessage<T = unknown> {
  fromAgent: string;
  toAgent: string;
  taskId: string;
  payload: T;
  priority: 'low' | 'normal' | 'high';
  createdAt: Date;
  expiresAt?: Date;
}

// Use a queue (Redis, Supabase, or in-process EventEmitter) as the handoff bus
// Never call another agent's methods directly from a subagent
```

