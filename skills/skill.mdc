## Memory Patterns

### Short-Term: Sliding Window Context
```typescript
class ContextWindow {
  private messages: Message[] = [];
  private readonly maxTokens: number;

  constructor(maxTokens = 8000) {
    this.maxTokens = maxTokens;
  }

  push(message: Message) {
    this.messages.push(message);
    this.prune();
  }

  private prune() {
    // Rough token estimate — replace with tiktoken in production
    while (this.estimatedTokens() > this.maxTokens && this.messages.length > 1) {
      this.messages.shift();
    }
  }

  private estimatedTokens(): number {
    return this.messages.reduce((acc, m) => acc + m.content.length / 4, 0);
  }

  toArray(): Message[] { return [...this.messages]; }
}
```

