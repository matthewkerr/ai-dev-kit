## LLM Orchestration

### Model Routing
Define a `models.config.ts` — never hardcode model strings inline:
```typescript
export const MODELS = {
  FAST:        'gpt-4o-mini',         // high-volume, low-latency
  REASONING:   'gpt-4o',              // complex decisions
  CHEAP:       'gpt-4o-mini',         // background tasks
  LOCAL:       'llama3.2',            // offline / sensitive data
  MULTIMODAL:  'gpt-4o',             // vision/audio
} as const;

export type ModelTier = keyof typeof MODELS;

export function getModel(tier: ModelTier): string {
  return MODELS[tier];
}
```

### Structured LLM Calls
Always use structured output with Zod validation. Never parse LLM text manually:
```typescript
import { z } from 'zod';

const DecisionSchema = z.object({
  action: z.enum(['proceed', 'wait', 'abort', 'escalate']),
  reasoning: z.string(),
  confidence: z.number().min(0).max(1),
  nextStepHint: z.string().optional(),
});

type Decision = z.infer<typeof DecisionSchema>;

async function reason(context: string): Promise<Decision> {
  const response = await openai.chat.completions.create({
    model: getModel('REASONING'),
    messages: [
      { role: 'system', content: SYSTEM_PROMPT },
      { role: 'user', content: context },
    ],
    response_format: { type: 'json_object' },
    temperature: 0.2,
  });

  const raw = JSON.parse(response.choices[0].message.content ?? '{}');
  return DecisionSchema.parse(raw); // throws on invalid — let it bubble
}
```

### Prompt Architecture
```typescript
// prompts/index.ts — keep all prompts co-located and versioned
export const prompts = {
  system: (agentName: string, capabilities: string[]) => `
You are ${agentName}, an autonomous agent with the following capabilities:
${capabilities.map(c => `- ${c}`).join('\n')}

You operate in a loop. Each cycle you receive context and must return a structured decision.
Be concise. Be decisive. Prefer action over inaction when confidence > 0.7.
  `.trim(),

  reason: (context: AgentContext) => `
Current state:
${JSON.stringify(context, null, 2)}

Based on this context, decide what action to take. Return JSON matching the Decision schema.
  `.trim(),
};
```

