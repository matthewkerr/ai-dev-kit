## Observability

### Structured Logging
```typescript
// Use a consistent log format — never console.log raw strings in agents
const log = {
  info:  (msg: string, meta?: object) => console.log(JSON.stringify({ level: 'info',  msg, ...meta, ts: new Date().toISOString() })),
  warn:  (msg: string, meta?: object) => console.log(JSON.stringify({ level: 'warn',  msg, ...meta, ts: new Date().toISOString() })),
  error: (msg: string, meta?: object) => console.log(JSON.stringify({ level: 'error', msg, ...meta, ts: new Date().toISOString() })),
  debug: (msg: string, meta?: object) => {
    if (process.env.DEBUG) console.log(JSON.stringify({ level: 'debug', msg, ...meta, ts: new Date().toISOString() }));
  },
};

// Usage inside agent cycles:
log.info('cycle complete', { iteration: this.iteration, durationMs, outcome: result.outcome });
```

