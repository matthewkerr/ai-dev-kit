## MCP (Model Context Protocol)

MCP is the standard protocol for exposing tools to LLMs. Build MCP servers for any capability you want agents to call:

```typescript
// mcp/server.ts — minimal MCP server using @modelcontextprotocol/sdk
import { Server } from '@modelcontextprotocol/sdk/server/index.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import { CallToolRequestSchema, ListToolsRequestSchema } from '@modelcontextprotocol/sdk/types.js';
import { z } from 'zod';

const server = new Server(
  { name: 'my-agent-tools', version: '1.0.0' },
  { capabilities: { tools: {} } }
);

// Register available tools
server.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: 'fetch_url',
      description: 'Fetches the text content of a URL',
      inputSchema: {
        type: 'object',
        properties: { url: { type: 'string', format: 'uri' } },
        required: ['url'],
      },
    },
  ],
}));

// Handle tool calls
server.setRequestHandler(CallToolRequestSchema, async (request) => {
  const { name, arguments: args } = request.params;

  if (name === 'fetch_url') {
    const { url } = z.object({ url: z.string().url() }).parse(args);
    const res = await fetch(url);
    const text = await res.text();
    return { content: [{ type: 'text', text: text.slice(0, 10_000) }] };
  }

  throw new Error(`Unknown tool: ${name}`);
});

// Start the server (stdio transport for local tools)
const transport = new StdioServerTransport();
await server.connect(transport);
```

