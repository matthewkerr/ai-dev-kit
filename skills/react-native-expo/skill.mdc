## Deep Linking & Universal Links

```typescript
// app.config.ts — configure scheme and universal links
const config: ExpoConfig = {
  // ...
  scheme: 'myapp',                         // myapp:// deep links
  ios: {
    associatedDomains: ['applinks:myapp.com'], // universal links
  },
  android: {
    intentFilters: [
      {
        action: 'VIEW',
        autoVerify: true,
        data: [{ scheme: 'https', host: 'myapp.com' }],
        category: ['BROWSABLE', 'DEFAULT'],
      },
    ],
  },
};
```

```typescript
// Expo Router handles deep links automatically via file-based routes.
// For manual linking:
import * as Linking from 'expo-linking';
import { router } from 'expo-router';

// Parse and handle incoming URL
const url = await Linking.getInitialURL();
if (url) {
  const { path, queryParams } = Linking.parse(url);
  router.push(`/${path}?${new URLSearchParams(queryParams as Record<string, string>)}`);
}
```

