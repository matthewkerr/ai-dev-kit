## Input Validation & Sanitization

### Never Trust Input
```typescript
// All external input must be validated before use — forms, APIs, webhooks, URL params
import { z } from 'zod';
import DOMPurify from 'isomorphic-dompurify';

// Zod schema as the single source of validation truth
const UserInputSchema = z.object({
  name:    z.string().min(1).max(100).trim(),
  email:   z.string().email().toLowerCase().trim(),
  bio:     z.string().max(500).optional().transform(v => v ? DOMPurify.sanitize(v) : v),
  website: z.string().url().optional().refine(url => {
    // Only allow http/https — prevent javascript: protocol injection
    return !url || url.startsWith('http://') || url.startsWith('https://');
  }, 'Only http/https URLs allowed'),
});

// Validate at the API boundary — before any business logic
export async function POST(req: NextRequest) {
  const body = await req.json();
  const result = UserInputSchema.safeParse(body);

  if (!result.success) {
    return NextResponse.json(
      { error: 'Invalid input', details: result.error.flatten() },
      { status: 400 }
    );
  }

  // result.data is now safe to use
  await createUser(result.data);
}
```

### SQL Injection Prevention
```typescript
// Always use parameterised queries — never string interpolation
// Supabase client handles this automatically via the query builder

// NEVER:
const bad = await supabase.rpc(`SELECT * FROM posts WHERE title = '${userInput}'`);

// ALWAYS — parameterised:
const good = await supabase
  .from('posts')
  .select('*')
  .eq('title', userInput);  // automatically escaped

// For raw Postgres (Edge Functions):
const result = await client.query(
  'SELECT * FROM posts WHERE title = $1 AND user_id = $2',
  [userInput, userId]  // $N parameters — never template literals
);
```

