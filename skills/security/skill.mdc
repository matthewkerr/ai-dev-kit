## Privacy-First Data Handling

```typescript
// Collect minimum data — only what is necessary for the feature
// Document data retention and deletion policies in code

interface UserData {
  id: string;
  email: string;              // required for auth
  displayName?: string;       // optional — user's choice
  // NEVER collect without explicit consent:
  // - precise location
  // - device fingerprint
  // - behavioral tracking
}

// Data deletion — implement before collecting data, not after
export async function deleteUserData(userId: string): Promise<void> {
  // Hard delete, not soft — "privacy for invisible people" means actual deletion
  await Promise.all([
    db.post.deleteMany({ where: { userId } }),
    db.session.deleteMany({ where: { userId } }),
    db.user.delete({ where: { id: userId } }),
    s3.deleteUserUploads(userId),   // remove all stored files
    analytics.deleteUser(userId),   // purge analytics events
  ]);
}

// Anonymisation for logs — never log PII
export function anonymiseForLogging(user: UserData): Record<string, unknown> {
  return {
    userId: user.id,          // ID is ok — not PII
    hasEmail: !!user.email,   // boolean presence only
    // email: user.email      // NEVER
    // ip: request.ip         // NEVER in persistent logs
  };
}
```

### Secrets Audit
```typescript
// Run in CI — detect accidentally committed secrets
// .github/workflows/secrets-scan.yml:
// - uses: trufflesecurity/trufflehog@main
//   with: { path: './', base: '${{ github.event.repository.default_branch }}' }

// Environment variable checklist — verify these exist at startup
const REQUIRED_SECRETS = [
  'JWT_SECRET',
  'DATABASE_URL',
  'SUPABASE_SERVICE_ROLE_KEY',
] as const;

export function validateSecrets(): void {
  const missing = REQUIRED_SECRETS.filter(key => !process.env[key]);
  if (missing.length > 0) {
    throw new Error(`Missing required secrets: ${missing.join(', ')}`);
  }

  if ((process.env.JWT_SECRET?.length ?? 0) < 32) {
    throw new Error('JWT_SECRET must be at least 32 characters');
  }
}

// Call at app startup — fail fast if misconfigured
validateSecrets();
```

