## OWASP Top 10 Mitigations

### A01 — Broken Access Control
```typescript
// Always check authorisation at the data layer, not just the route
// Never rely solely on "the UI hides the button"

export async function getPost(postId: string, requestingUserId: string): Promise<Post> {
  const post = await db.post.findUnique({ where: { id: postId } });

  if (!post) throw new NotFoundError('Post', postId);

  // Explicit ownership check — even if the route is "authenticated"
  if (post.userId !== requestingUserId && !post.published) {
    throw new ForbiddenError('Cannot access unpublished post');
  }

  return post;
}
```

### A02 — Cryptographic Failures
```typescript
// Passwords — always bcrypt/argon2, never MD5/SHA1/plain
import { hash, verify } from '@node-rs/argon2';

export async function hashPassword(password: string): Promise<string> {
  return hash(password, {
    memoryCost: 19456,  // 19 MiB
    timeCost: 2,
    outputLen: 32,
    parallelism: 1,
  });
}

export async function verifyPassword(hash: string, password: string): Promise<boolean> {
  return verify(hash, password);
}

// Tokens — use crypto.randomBytes, never Math.random()
import { randomBytes } from 'crypto';

export function generateSecureToken(bytes = 32): string {
  return randomBytes(bytes).toString('hex');
}
```

### A03 — Injection (XSS)
```typescript
// React auto-escapes JSX — dangerous patterns to avoid:

// NEVER — arbitrary HTML from user input
<div dangerouslySetInnerHTML={{ __html: userContent }} />

// SAFER — sanitize first if rich text is a requirement
import DOMPurify from 'isomorphic-dompurify';
const clean = DOMPurify.sanitize(userContent, {
  ALLOWED_TAGS: ['p', 'b', 'i', 'em', 'strong', 'a', 'ul', 'ol', 'li'],
  ALLOWED_ATTR: ['href'],
  ALLOW_DATA_ATTR: false,
});
<div dangerouslySetInnerHTML={{ __html: clean }} />

// Content Security Policy — set via headers, not meta tags
// In next.config.ts:
const securityHeaders = [
  { key: 'Content-Security-Policy', value: "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';" },
  { key: 'X-Frame-Options', value: 'DENY' },
  { key: 'X-Content-Type-Options', value: 'nosniff' },
  { key: 'Referrer-Policy', value: 'strict-origin-when-cross-origin' },
  { key: 'Permissions-Policy', value: 'camera=(), microphone=(), geolocation=()' },
];
```

### A07 — Authentication Failures
```typescript
// Constant-time comparison for secrets — prevents timing attacks
import { timingSafeEqual } from 'crypto';

export function safeCompare(a: string, b: string): boolean {
  const bufA = Buffer.from(a);
  const bufB = Buffer.from(b);
  if (bufA.length !== bufB.length) return false;
  return timingSafeEqual(bufA, bufB);
}

// Account enumeration prevention — same response for valid and invalid email
export async function login(email: string, password: string): Promise<AuthResult> {
  const user = await db.user.findUnique({ where: { email } });

  // Always run the hash comparison — even if user doesn't exist
  // This prevents timing-based user enumeration
  const dummyHash = '$argon2id$v=19$m=19456,t=2,p=1$dummy';
  const hashToVerify = user?.passwordHash ?? dummyHash;
  const valid = await verifyPassword(hashToVerify, password);

  if (!user || !valid) {
    throw new UnauthorizedError('Invalid credentials'); // same message always
  }

  return createSession(user);
}
```

