## PHPUnit — Laravel

### Feature Test Scaffold
```php
<?php

declare(strict_types=1);

namespace Tests\Feature\Api;

use App\Models\Post;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Foundation\Testing\WithFaker;
use Tests\TestCase;

class PostApiTest extends TestCase
{
    use RefreshDatabase, WithFaker;

    private User $user;

    protected function setUp(): void
    {
        parent::setUp();
        $this->user = User::factory()->create();
    }

    public function test_authenticated_user_can_create_post(): void
    {
        $response = $this->actingAs($this->user)
            ->postJson('/api/v1/posts', [
                'title'   => 'My Post Title',
                'slug'    => 'my-post-title',
                'content' => str_repeat('Long enough content. ', 5),
            ]);

        $response->assertCreated()
            ->assertJsonStructure(['data' => ['id', 'title', 'slug', 'created_at']])
            ->assertJsonPath('data.title', 'My Post Title');

        $this->assertDatabaseHas('posts', [
            'slug'    => 'my-post-title',
            'user_id' => $this->user->id,
        ]);
    }

    public function test_returns_422_for_duplicate_slug(): void
    {
        Post::factory()->create(['slug' => 'taken-slug', 'user_id' => $this->user->id]);

        $this->actingAs($this->user)
            ->postJson('/api/v1/posts', [
                'title'   => 'Different Title',
                'slug'    => 'taken-slug',
                'content' => str_repeat('Content. ', 5),
            ])
            ->assertUnprocessable()
            ->assertJsonValidationErrors(['slug']);
    }

    public function test_unauthenticated_request_returns_401(): void
    {
        $this->postJson('/api/v1/posts', [])->assertUnauthorized();
    }

    public function test_user_cannot_update_another_users_post(): void
    {
        $post = Post::factory()->create(); // different user

        $this->actingAs($this->user)
            ->putJson("/api/v1/posts/{$post->id}", ['title' => 'Hijacked'])
            ->assertForbidden();
    }
}
```

### Model Factory Patterns
```php
// database/factories/PostFactory.php
class PostFactory extends Factory
{
    public function definition(): array
    {
        return [
            'user_id'   => User::factory(),   // auto-creates related user
            'title'     => $this->faker->sentence(4),
            'slug'      => $this->faker->unique()->slug(),
            'content'   => $this->faker->paragraphs(3, true),
            'published' => false,
        ];
    }

    // State methods for common variations
    public function published(): static
    {
        return $this->state(['published' => true, 'published_at' => now()]);
    }

    public function forUser(User $user): static
    {
        return $this->state(['user_id' => $user->id]);
    }
}

// Usage: Post::factory()->published()->forUser($user)->count(3)->create()
```

