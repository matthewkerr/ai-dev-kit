## React Testing Library

### Component Test Scaffold
```tsx
// components/features/SearchBar.test.tsx
import { describe, it, expect, vi } from 'vitest';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { SearchBar } from './SearchBar';

// Always use userEvent over fireEvent — it simulates real browser events
const user = userEvent.setup();

describe('SearchBar', () => {
  it('renders with default placeholder', () => {
    render(<SearchBar onSearch={vi.fn()} />);
    expect(screen.getByRole('searchbox')).toHaveAttribute('placeholder', 'Search...');
  });

  it('calls onSearch with typed value after debounce', async () => {
    const onSearch = vi.fn();
    render(<SearchBar onSearch={onSearch} debounceMs={0} />);

    await user.type(screen.getByRole('searchbox'), 'hello');

    await waitFor(() => {
      expect(onSearch).toHaveBeenCalledWith('hello');
    });
  });

  it('clears input when clear button is clicked', async () => {
    render(<SearchBar onSearch={vi.fn()} defaultValue="existing" />);
    const input = screen.getByRole('searchbox');
    expect(input).toHaveValue('existing');

    await user.click(screen.getByRole('button', { name: /clear/i }));
    expect(input).toHaveValue('');
  });

  it('shows loading indicator while searching', async () => {
    render(<SearchBar onSearch={vi.fn()} isLoading />);
    expect(screen.getByRole('status')).toBeInTheDocument(); // aria-role="status" on spinner
  });
});
```

### Custom Hook Tests
```typescript
// hooks/useCounter.test.ts
import { renderHook, act } from '@testing-library/react';
import { useCounter } from './useCounter';

describe('useCounter', () => {
  it('initialises with default value', () => {
    const { result } = renderHook(() => useCounter());
    expect(result.current.count).toBe(0);
  });

  it('increments count', () => {
    const { result } = renderHook(() => useCounter(5));

    act(() => { result.current.increment(); });

    expect(result.current.count).toBe(6);
  });

  it('does not exceed max', () => {
    const { result } = renderHook(() => useCounter(10, { max: 10 }));

    act(() => { result.current.increment(); });

    expect(result.current.count).toBe(10); // clamped
  });
});
```

### Server Action / Form Tests
```typescript
// lib/actions/posts.test.ts
import { describe, it, expect, vi } from 'vitest';
import { createPost } from './posts';

vi.mock('@/lib/auth', () => ({
  auth: vi.fn().mockResolvedValue({ user: { id: 'user-1' } }),
}));

vi.mock('@/lib/db', () => ({
  db: { post: { create: vi.fn() } },
}));

describe('createPost action', () => {
  function makeFormData(data: Record<string, string>) {
    const fd = new FormData();
    Object.entries(data).forEach(([k, v]) => fd.set(k, v));
    return fd;
  }

  it('creates post and returns success state', async () => {
    vi.mocked(db.post.create).mockResolvedValue({ id: 'post-1' });

    const result = await createPost({}, makeFormData({
      title: 'Test Post',
      content: 'Long enough content here.',
    }));

    expect(result.errors).toBeUndefined();
    expect(db.post.create).toHaveBeenCalledWith(
      expect.objectContaining({ data: expect.objectContaining({ title: 'Test Post' }) })
    );
  });

  it('returns validation errors for missing title', async () => {
    const result = await createPost({}, makeFormData({ content: 'content' }));

    expect(result.errors?.title).toBeDefined();
    expect(db.post.create).not.toHaveBeenCalled();
  });
});
```

