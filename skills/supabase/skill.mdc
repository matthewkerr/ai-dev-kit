## pgvector — Vector Search

For RAG pipelines, semantic memory, and similarity search:

```sql
-- Enable the extension once per project
CREATE EXTENSION IF NOT EXISTS vector;

-- Add an embedding column to any table
ALTER TABLE posts ADD COLUMN embedding vector(1536);  -- 1536 for OpenAI text-embedding-3-small

-- Index for fast ANN search (IVFFlat for large tables, HNSW for accuracy)
CREATE INDEX idx_posts_embedding ON posts
  USING hnsw (embedding vector_cosine_ops);

-- Semantic similarity search
SELECT id, title, 1 - (embedding <=> $1::vector) AS similarity
FROM posts
WHERE published = true
ORDER BY embedding <=> $1::vector
LIMIT 10;
```

```typescript
// lib/embeddings.ts — generate and store embeddings
import OpenAI from 'openai';

const openai = new OpenAI();

export async function embed(text: string): Promise<number[]> {
  const { data } = await openai.embeddings.create({
    model: 'text-embedding-3-small',
    input: text.slice(0, 8000), // hard limit
  });
  return data[0].embedding;
}

// Store embedding on upsert
export async function upsertWithEmbedding(supabase: SupabaseClient, post: PostInsert) {
  const embedding = await embed(`${post.title}\n\n${post.content}`);
  const { error } = await supabase
    .from('posts')
    .upsert({ ...post, embedding: JSON.stringify(embedding) });
  if (error) throw error;
}

// Semantic search
export async function semanticSearch(supabase: SupabaseClient, query: string, limit = 10) {
  const embedding = await embed(query);
  const { data, error } = await supabase.rpc('search_posts', {
    query_embedding: embedding,
    match_count: limit,
  });
  if (error) throw error;
  return data;
}
```

```sql
-- Companion RPC function for semantic search
CREATE OR REPLACE FUNCTION search_posts(query_embedding vector, match_count int)
RETURNS TABLE (id uuid, title text, similarity float)
LANGUAGE sql STABLE AS $$
  SELECT id, title, 1 - (embedding <=> query_embedding) AS similarity
  FROM posts
  WHERE published = true
  ORDER BY embedding <=> query_embedding
  LIMIT match_count;
$$;
```

