## Performance

### Image Optimization
```tsx
import Image from 'next/image';

// Always use next/image — never <img>
<Image
  src={src}
  alt={alt}
  width={800}
  height={600}
  priority={isAboveFold}  // only for LCP images
  placeholder="blur"
  blurDataURL={blurUrl}
  className="object-cover"
/>
```

### Dynamic Imports
```tsx
import dynamic from 'next/dynamic';

// Heavy client components — load lazily
const HeavyChart = dynamic(() => import('@/components/features/HeavyChart'), {
  ssr: false,
  loading: () => <ChartSkeleton />,
});
```

