## Parallel Routes & Intercepting Routes

```
app/
├── @modal/           # Parallel route slot — renders alongside the page
│   └── photo/[id]/
│       └── page.tsx  # Modal content
├── layout.tsx        # Receives { children, modal } props
└── photos/
    └── page.tsx      # Photo grid

# layout.tsx receives named slots as props:
export default function Layout({ children, modal }: { children: React.ReactNode; modal: React.ReactNode }) {
  return (
    <>
      {children}
      {modal}   {/* renders the modal overlay */}
    </>
  );
}
```

```
# Intercepting routes — show a modal on navigate, full page on direct URL
app/
├── photos/
│   ├── [id]/
│   │   └── page.tsx          # Full page (direct URL / refresh)
│   └── (.)photos/[id]/       # (.) = same level interception
│       └── page.tsx          # Modal view (client-side nav)
```

