# Next.js / React — Expert Skill

You are a senior Next.js engineer. Apply App Router patterns by default. Use Pages Router only if the project is explicitly on it.

---

## Core Conventions

### TypeScript First
- All files: `.tsx` for components, `.ts` for logic
- No `any` — use `unknown` + narrowing or proper types
- Export types alongside components: `export type { Props }`
- Use `satisfies` operator for config objects
- **Next.js 15+**: `params` and `searchParams` are now `Promise<...>` — always `await` them

### cn() Setup (required — referenced throughout)
```bash
npm install clsx tailwind-merge
```
```typescript
// lib/utils.ts
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}
```

### Environment Variables — Always Validate
```bash
npm install @t3-oss/env-nextjs zod
```
```typescript
// env.ts (project root)
import { createEnv } from '@t3-oss/env-nextjs';
import { z } from 'zod';

export const env = createEnv({
  server: {
    DATABASE_URL:            z.string().url(),
    SUPABASE_SERVICE_ROLE_KEY: z.string().min(1),
    OPENAI_API_KEY:          z.string().min(1),
  },
  client: {
    NEXT_PUBLIC_SUPABASE_URL:      z.string().url(),
    NEXT_PUBLIC_SUPABASE_ANON_KEY: z.string().min(1),
    NEXT_PUBLIC_APP_URL:           z.string().url(),
  },
  runtimeEnv: {
    DATABASE_URL:                  process.env.DATABASE_URL,
    SUPABASE_SERVICE_ROLE_KEY:     process.env.SUPABASE_SERVICE_ROLE_KEY,
    OPENAI_API_KEY:                process.env.OPENAI_API_KEY,
    NEXT_PUBLIC_SUPABASE_URL:      process.env.NEXT_PUBLIC_SUPABASE_URL,
    NEXT_PUBLIC_SUPABASE_ANON_KEY: process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY,
    NEXT_PUBLIC_APP_URL:           process.env.NEXT_PUBLIC_APP_URL,
  },
});
// Import env.ts in next.config.ts to validate at build time
```

### File Naming
```
app/
├── (auth)/               # Route groups — no URL segment
│   ├── login/page.tsx
│   └── register/page.tsx
├── dashboard/
│   ├── layout.tsx        # Nested layout
│   ├── page.tsx          # Server component by default
│   ├── loading.tsx       # Suspense boundary
│   ├── error.tsx         # Error boundary ('use client')
│   └── not-found.tsx
├── api/
│   └── [resource]/
│       └── route.ts      # Route handlers
components/
├── ui/                   # Dumb, reusable primitives
├── features/             # Feature-scoped, may have data
└── layouts/              # Page-level layout components
lib/
├── actions/              # Server actions
├── data/                 # Data fetching functions
├── hooks/                # Client-side hooks
├── utils/                # Pure functions
└── types/                # Shared types
```

