## Evals

Never ship a prompt change without running evals:

```typescript
// evals/classify.eval.ts
interface EvalCase {
  input: string;
  expected: string;
  description?: string;
}

interface EvalResult {
  input: string;
  expected: string;
  actual: string;
  passed: boolean;
  latencyMs: number;
  tokensUsed: number;
}

const TEST_CASES: EvalCase[] = [
  { input: 'How do I reset my password?', expected: 'QUESTION',  description: 'Clear question' },
  { input: 'Please update my email',      expected: 'REQUEST',   description: 'Clear request' },
  { input: 'This is broken',              expected: 'COMPLAINT', description: 'Implicit complaint' },
  { input: 'Just checking in',            expected: 'OTHER',     description: 'Ambiguous' },
  // Always include edge cases that previously failed
];

export async function runEvals(promptVersion: string): Promise<void> {
  const results: EvalResult[] = [];

  for (const tc of TEST_CASES) {
    const start = Date.now();
    const actual = await classify(tc.input);
    const latencyMs = Date.now() - start;

    results.push({
      input: tc.input,
      expected: tc.expected,
      actual,
      passed: actual === tc.expected,
      latencyMs,
      tokensUsed: 0, // fill from response.usage
    });
  }

  const passed = results.filter(r => r.passed).length;
  const accuracy = passed / results.length;

  console.table(results.map(r => ({
    input: r.input.slice(0, 30),
    expected: r.expected,
    actual: r.actual,
    passed: r.passed ? 'Y' : 'FAIL',
    ms: r.latencyMs,
  })));

  console.log(`\nAccuracy: ${(accuracy * 100).toFixed(1)}% (${passed}/${results.length})`);

  // Fail CI if accuracy drops below threshold
  if (accuracy < 0.9) {
    throw new Error(`Eval failed: accuracy ${accuracy} < 0.9 threshold`);
  }
}
```

