## Local Models (Ollama)

```typescript
// lib/ai/ollama.ts — drop-in replacement for OpenAI client
import OpenAI from 'openai'; // Ollama exposes OpenAI-compatible API

export const ollama = new OpenAI({
  baseURL: process.env.OLLAMA_BASE_URL ?? 'http://localhost:11434/v1',
  apiKey: 'ollama', // required by client, not used by Ollama
});

// Use the same interface — swap providers without changing call sites
export async function localCompletion(prompt: string): Promise<string> {
  const response = await ollama.chat.completions.create({
    model: process.env.MODEL_LOCAL ?? 'qwen2.5-coder:32b',
    messages: [{ role: 'user', content: prompt }],
    temperature: 0.2,
  });
  return response.choices[0].message.content ?? '';
}
```

