## Structured Output

Always use structured output — never parse free-form LLM text:

```typescript
import OpenAI from 'openai';
import { z } from 'zod';
import { zodResponseFormat } from 'openai/helpers/zod';

const client = new OpenAI();

const ExtractedDataSchema = z.object({
  title:    z.string(),
  summary:  z.string().max(500),
  topics:   z.array(z.string()).max(5),
  sentiment: z.enum(['positive', 'neutral', 'negative']),
  score:    z.number().min(0).max(10),
});

type ExtractedData = z.infer<typeof ExtractedDataSchema>;

export async function extractFromText(text: string): Promise<ExtractedData> {
  const response = await client.beta.chat.completions.parse({
    model: selectModel('REASONING'),
    messages: [
      { role: 'system', content: 'Extract structured data from the provided text.' },
      { role: 'user',   content: text },
    ],
    response_format: zodResponseFormat(ExtractedDataSchema, 'extracted_data'),
    temperature: 0.1,  // low for structured extraction
  });

  const parsed = response.choices[0].message.parsed;
  if (!parsed) throw new Error('Structured output parsing failed');
  return parsed;
}
```

### Anthropic Structured Output
```typescript
import Anthropic from '@anthropic-ai/sdk';

const anthropic = new Anthropic();

export async function reasonWithClaude(prompt: string): Promise<Decision> {
  const message = await anthropic.messages.create({
    model: 'claude-sonnet-4-20250514',
    max_tokens: 1024,
    system: `${SYSTEM_PROMPT}\n\nYou MUST respond with valid JSON matching this schema exactly:\n${JSON.stringify(DecisionSchema.shape)}`,
    messages: [{ role: 'user', content: prompt }],
  });

  const text = message.content
    .filter(b => b.type === 'text')
    .map(b => b.text)
    .join('');

  // Strip markdown fences if present
  const clean = text.replace(/^```(?:json)?\n?/m, '').replace(/\n?```$/m, '').trim();
  return DecisionSchema.parse(JSON.parse(clean));
}
```

