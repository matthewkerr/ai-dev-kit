## Prompt Engineering

### Prompt Architecture
```typescript
// prompts/base.ts — structured prompt composition
interface PromptParts {
  system: string;
  context?: string;
  examples?: Array<{ input: string; output: string }>;
  instructions: string;
  outputFormat?: string;
}

function buildPrompt(parts: PromptParts): string {
  const sections: string[] = [parts.system];

  if (parts.context) {
    sections.push(`## Context\n${parts.context}`);
  }

  if (parts.examples?.length) {
    const exBlock = parts.examples
      .map((e, i) => `Example ${i + 1}:\nInput: ${e.input}\nOutput: ${e.output}`)
      .join('\n\n');
    sections.push(`## Examples\n${exBlock}`);
  }

  sections.push(`## Task\n${parts.instructions}`);

  if (parts.outputFormat) {
    sections.push(`## Output Format\n${parts.outputFormat}`);
  }

  return sections.join('\n\n');
}
```

### Prompt Versioning
```typescript
// prompts/classify.ts — version every prompt, never edit in-place
export const CLASSIFY_PROMPT_V2 = {
  version: 'v2',
  updatedAt: '2025-03-01',
  changelog: 'Added edge case examples for ambiguous inputs',

  system: `You are a classification expert. Classify user inputs into exactly one category.
Categories: QUESTION | REQUEST | FEEDBACK | COMPLAINT | OTHER

Rules:
- Return only the category name, nothing else
- When ambiguous, prefer the more specific category
- Inputs with "?" are usually QUESTION, not REQUEST`,

  examples: [
    { input: 'How do I reset my password?', output: 'QUESTION' },
    { input: 'Please update my email',      output: 'REQUEST'  },
    { input: 'This is broken',              output: 'COMPLAINT'},
  ],
} as const;

// Always log which version was used — essential for debugging regressions
log.info('llm call', { promptVersion: CLASSIFY_PROMPT_V2.version, model: selectModel('CHEAP') });
```

### Chain-of-Thought for Reasoning Tasks
```typescript
// For complex decisions — prompt for reasoning before the answer
const COT_SYSTEM = `You are a decision engine. When asked to decide, always:
1. State what information you have
2. Identify what's uncertain or missing
3. Reason through the tradeoffs
4. State your decision with confidence level (0.0-1.0)
5. Return structured JSON matching the schema exactly`;

// Then validate with Zod — never trust the raw output
const DecisionSchema = z.object({
  reasoning:  z.string().min(20),   // force non-trivial reasoning
  decision:   z.string(),
  confidence: z.number().min(0).max(1),
  caveats:    z.array(z.string()).optional(),
});
```

