## Cost Management

```typescript
// lib/ai/cost-tracker.ts — track spend per feature/user
const TOKEN_COSTS_PER_1K = {
  'gpt-4o':           { input: 0.0025, output: 0.01   },
  'gpt-4o-mini':      { input: 0.00015, output: 0.0006 },
  'claude-sonnet-4':  { input: 0.003,  output: 0.015  },
  'text-embedding-3-small': { input: 0.00002, output: 0 },
} as const;

export function estimateCost(
  model: string,
  inputTokens: number,
  outputTokens: number
): number {
  const rates = TOKEN_COSTS_PER_1K[model as keyof typeof TOKEN_COSTS_PER_1K];
  if (!rates) return 0;
  return (inputTokens / 1000) * rates.input + (outputTokens / 1000) * rates.output;
}

// Wrap every LLM call with cost tracking
export async function trackedCompletion(
  params: OpenAI.ChatCompletionCreateParams,
  context: { feature: string; userId?: string }
): Promise<OpenAI.ChatCompletion> {
  const response = await client.chat.completions.create(params);
  const cost = estimateCost(
    params.model,
    response.usage?.prompt_tokens ?? 0,
    response.usage?.completion_tokens ?? 0
  );

  log.info('llm usage', {
    model: params.model,
    feature: context.feature,
    userId: context.userId,
    inputTokens:  response.usage?.prompt_tokens,
    outputTokens: response.usage?.completion_tokens,
    estimatedCostUsd: cost,
  });

  return response;
}
```

### Token Budget Enforcement
```typescript
// Estimate tokens before sending — prevent runaway costs
import { encoding_for_model } from 'tiktoken';

export function countTokens(text: string, model = 'gpt-4o'): number {
  const enc = encoding_for_model(model as Parameters<typeof encoding_for_model>[0]);
  const count = enc.encode(text).length;
  enc.free();
  return count;
}

export function truncateToTokenLimit(text: string, maxTokens: number, model = 'gpt-4o'): string {
  const enc = encoding_for_model(model as Parameters<typeof encoding_for_model>[0]);
  const tokens = enc.encode(text);
  if (tokens.length <= maxTokens) { enc.free(); return text; }
  const truncated = new TextDecoder().decode(enc.decode(tokens.slice(0, maxTokens)));
  enc.free();
  return truncated;
}
```

