## RAG Pipeline

### Document Chunking
```typescript
// lib/rag/chunker.ts
interface Chunk {
  id: string;
  content: string;
  metadata: {
    source: string;
    chunkIndex: number;
    totalChunks: number;
    startChar: number;
    endChar: number;
  };
}

export function chunkText(
  text: string,
  source: string,
  opts: { chunkSize?: number; overlap?: number } = {}
): Chunk[] {
  const { chunkSize = 512, overlap = 64 } = opts;
  const chunks: Chunk[] = [];
  let start = 0;
  let index = 0;

  // Split on sentence boundaries when possible — preserve semantic units
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [text];
  let current = '';

  for (const sentence of sentences) {
    if ((current + sentence).length > chunkSize && current.length > 0) {
      chunks.push({
        id: `${source}-${index}`,
        content: current.trim(),
        metadata: { source, chunkIndex: index, totalChunks: 0, startChar: start, endChar: start + current.length },
      });
      // Overlap: keep last N chars for context continuity
      current = current.slice(-overlap) + sentence;
      start += current.length - overlap;
      index++;
    } else {
      current += sentence;
    }
  }

  if (current.trim()) {
    chunks.push({
      id: `${source}-${index}`,
      content: current.trim(),
      metadata: { source, chunkIndex: index, totalChunks: 0, startChar: start, endChar: start + current.length },
    });
  }

  // Backfill totalChunks
  const total = chunks.length;
  return chunks.map(c => ({ ...c, metadata: { ...c.metadata, totalChunks: total } }));
}
```

### Retrieval + Reranking
```typescript
// lib/rag/retriever.ts
interface RetrievedChunk extends Chunk {
  similarity: number;
}

export async function retrieve(
  supabase: SupabaseClient,
  query: string,
  opts: { limit?: number; threshold?: number; rerank?: boolean } = {}
): Promise<RetrievedChunk[]> {
  const { limit = 10, threshold = 0.7, rerank = true } = opts;

  // Step 1: Embed the query
  const queryEmbedding = await embed(query);

  // Step 2: Vector search
  const { data, error } = await supabase.rpc('search_documents', {
    query_embedding: queryEmbedding,
    match_count: rerank ? limit * 3 : limit,  // fetch more if reranking
    match_threshold: threshold,
  });
  if (error) throw error;

  // Step 3: Rerank with LLM (optional — improves precision, adds cost)
  if (!rerank || !data?.length) return data ?? [];
  return rerankChunks(query, data, limit);
}

async function rerankChunks(
  query: string,
  chunks: RetrievedChunk[],
  limit: number
): Promise<RetrievedChunk[]> {
  // Simple LLM reranker — score each chunk's relevance to the query
  const scores = await Promise.all(
    chunks.map(async (chunk) => {
      const response = await client.chat.completions.create({
        model: selectModel('CHEAP'),
        messages: [{
          role: 'user',
          content: `Rate how relevant this passage is to answering the query.
Query: ${query}
Passage: ${chunk.content}
Return only a number 0-10.`,
        }],
        temperature: 0,
        max_tokens: 5,
      });
      const score = parseFloat(response.choices[0].message.content ?? '0');
      return { ...chunk, rerankScore: isNaN(score) ? 0 : score };
    })
  );

  return scores
    .sort((a, b) => b.rerankScore - a.rerankScore)
    .slice(0, limit);
}
```

### RAG Response Generation
```typescript
// lib/rag/generate.ts
export async function generateWithContext(
  query: string,
  chunks: RetrievedChunk[]
): Promise<{ answer: string; sources: string[] }> {
  if (!chunks.length) {
    return { answer: "I don't have enough information to answer that.", sources: [] };
  }

  const context = chunks
    .map((c, i) => `[${i + 1}] (Source: ${c.metadata.source})\n${c.content}`)
    .join('\n\n');

  const response = await client.chat.completions.create({
    model: selectModel('REASONING'),
    messages: [
      {
        role: 'system',
        content: `Answer questions using only the provided context.
If the context doesn't contain enough information, say so — do not hallucinate.
Cite sources using [N] notation matching the context numbers.`,
      },
      { role: 'user', content: `Context:\n${context}\n\nQuestion: ${query}` },
    ],
    temperature: 0.2,
  });

  const answer = response.choices[0].message.content ?? '';
  const sources = [...new Set(chunks.map(c => c.metadata.source))];
  return { answer, sources };
}
```

